    "color": {
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "name": "Primary",
          "slug": "primary",
          "color": "#004F71"
        },
        {
          "name": "Secondary",
          "slug": "secondary",
          "color": "#008098"
        },
         {
          "name": "Accent Alt",
          "slug": "accent-alt",
          "color": "#5e4936"
        },
        {
          "name": "Accent",
