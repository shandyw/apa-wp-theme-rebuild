          "color": "#F2F0E6"
        },
        {
          "name": "Muted",
          "slug": "muted",
          "color": "#EBEBEB"
        },
        {
          "name": "Taupe",
          "slug": "taupe",
          "color": "#D0C8BE"
        },
        {
          "name": "Yellow",
          "slug": "yellow",
          "color": "#FBDE50"
        },
        {
          "name": "Light Green",
          "slug": "light-green",
          "color": "#8AC168"
        },
        {
          "name": "Pale Green",
          "slug": "pale-green",
          "color": "#f2f0e7"
        },
        {
          "name": "Blue",
          "slug": "blue",
          "color": "#00A7B5"
        },
        {
          "name": "Bright Green",
          "slug": "bright-green",
          "color": "#91CA64"
        },
    
         {
          "name": "Bright Green Hover",
          "slug": "bright-green-hover",
          "color": "#E1EED3"
        },
        {
          "name": "Border Gold",
          "slug": "border-gold",
          "color": "#E2AA33"
        },
        {
          "name": "Navigation",
          "slug": "navigation",
          "color": "#7D7664"
        },
        {
          "name": "Light",
          "slug": "light",
          "color": "#F8F9FA"
        },
        {
          "name": "Dark",
          "slug": "dark",
          "color": "#3D3731"
        },
        {
          "name": "Green",
          "slug": "green",
          "color": "#1C4D2A"
        },
        {
          "name": "Link",
          "slug": "link",
          "color": "#d9ae3b"
        },
         {
          "name": "Link Hover",
          "slug": "link-hover",
          "color": "#987017"
        },
        {
          "name": "Error",
          "slug": "error",
          "color": "#D0021B"
        }
      ]
    },
    "layout": {
      "contentSize": "1170px",
      "wideSize": "1360px"
    },
    "spacing": {
      "blockGap": "30px",
      "defaultSpacingSizes": false,
      "margin": true,
      "padding": true,
      "spacingSizes": [
        {
          "name": "10",
          "slug": "10",
          "size": "10px"
        },
         {
          "name": "15",
          "slug": "15",
          "size": "15px"
        },
        {
          "name": "20",
          "slug": "20",
          "size": "20px"
        },
        {
          "name": "30",
          "slug": "30",
          "size": "30px"
        },
        {
          "name": "40",
          "slug": "40",
          "size": "40px"
        },
        {
          "name": "50",
          "slug": "50",
          "size": "50px"
        },
        {
          "name": "60",
          "slug": "60",
          "size": "60px"
        },
        {
          "name": "70",
          "slug": "70",
          "size": "70px"
        },
        {
          "name": "80",
          "slug": "80",
          "size": "80px"
        },
        {
          "name": "90",
          "slug": "90",
          "size": "90px"
        },
        {
          "name": "100",
          "slug": "100",
          "size": "100px"
        }
      ],
      "units": [
        "%",
        "px",
        "em",
        "rem",
        "vh",
        "vw"
      ]
    },
    "typography": {
      "dropCap": false,
      "fontFamilies": [
        {
          "fontFace": [
            {
              "fontDisplay": "swap",
              "fontFamily": "PostGroteskBook",
              "fontStyle": "normal",
              "fontWeight": "400",
              "src": [
                "file:./assets/fonts/PostGrotesk-Book.woff2"
              ]
            },
            {
              "fontDisplay": "swap",
              "fontFamily": "PostGroteskBook",
              "fontStyle": "normal",
              "fontWeight": "700",
              "src": [
                "file:./assets/fonts/PostGrotesk-Bold.woff2"
              ]
            }
          ],
          "fontFamily": "\"PostGroteskBook\", Arial, sans-serif",
          "name": "PostGroteskBook",
          "slug": "post-grotesk-book"
        },
        {
          "fontFamily": "\"freight-text-pro\", Georgia, serif",
          "name": "Freight Text Pro",
          "slug": "freight-text-pro"
        }
      ],
      "fontWeights": [
        {
          "name": "Bold",
          "slug": "bold",
          "fontWeight": "700"
        }
      ],
      "fontSizes": [
        {
          "name": "XS",
          "slug": "xs",
          "size": "14px"
        },
        {
          "name": "Small",
          "slug": "small",
          "size": "16px"
        },
        {
          "name": "Normal",
          "slug": "normal",
          "size": "18px"
        },
        {
          "name": "Medium",
          "slug": "medium",
          "size": "20px"
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "24px"
        },
        {
          "name": "Heading 4",
          "slug": "heading-4",
          "size": "22px"
        },
        {
          "name": "Heading 3",
          "slug": "heading-3",
          "size": "26px"
        },
        {
          "name": "Heading 2",
          "slug": "heading-2",
          "size": "46px"
        },
        {
          "name": "Heading 1",
          "slug": "heading-1",
          "size": "52px"
        },
        {
          "name": "Label",
          "slug": "label",
          "size": "16px"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--contrast)"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--30)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--post-grotesk-book)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.2"
    },
    "elements": {
      "button": {
        "border": {
          "radius": "0"
        },
        "color": {
          "background": "var(--wp--preset--color--dark)",
          "text": "var(--wp--preset--color--base)"
        },
        "spacing": {
          "padding": {
            "bottom": "10px",
            "left": "25px",
            "right": "25px",
            "top": "10px"
          }
        },
        "typography": {
          "fontFamily": "var()",
          "fontSize": "var(--wp--preset--font-size--label)",
          "lineHeight": "1.1",
          "textTransform": "uppercase"
        }
      },
      "caption": {
        "color": {
          "text": "var(--wp--preset--color--contrast)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "lineHeight": "1.4"
        }
      },
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--post-grotesk-book)",
          "fontSize": "var(--wp--preset--font-size--heading-1)",
          "fontWeight": "700",
          "lineHeight": "1"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--post-grotesk-book)",
          "fontSize": "var(--wp--preset--font-size--heading-2)",
          "fontWeight": "700",
          "lineHeight": "1.04"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--post-grotesk-book)",
          "fontSize": "var(--wp--preset--font-size--heading-3)",
          "fontWeight": "400",
          "lineHeight": "1.08"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--post-grotesk-book)",
          "fontSize": "var(--wp--preset--font-size--heading-4)",
          "fontWeight": "700",
          "lineHeight": "1.08"
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--post-grotesk-book)",
          "fontSize": "var(--wp--preset--font-size--label)",
          "fontWeight": "700",
          "lineHeight": "1.11",
          "textTransform": "uppercase"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--post-grotesk-book)",
          "fontSize": "21px",
          "fontWeight": "400",
          "lineHeight": "1.33"
        }
      },
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--contrast)"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--link)"
        },
        "typography": {
          "textDecoration": "none"
        },
        ":hover": {
          "typography": {
            "textDecoration": "underline"
          }
        }
      }
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": "0"
        }
      },
      "core/pullquote": {
        "border": {
          "color": "var(--wp--preset--color--accent)",
          "style": "solid",
          "width": "0 0 0 4px"
        },
        "spacing": {
          "padding": {
            "left": "var(--wp--preset--spacing--30)"
          }
        }
      },
      "core/quote": {
        "border": {
          "color": "var(--wp--preset--color--accent)",
          "style": "solid",
          "width": "0 0 0 4px"
        },
        "spacing": {
          "padding": {
            "left": "var(--wp--preset--spacing--20)"
          }
        }
      },
      "core/separator": {
        "border": {
          "color": "var(--wp--preset--color--muted)"
        }
      }
    }
  }
}
