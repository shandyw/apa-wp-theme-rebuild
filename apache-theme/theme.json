          "slug": "accent-hover",
          "color": "#CA9D39"
        },
        {
          "name": "Highlight",
          "slug": "highlight",
          "color": "#00A7B5"
        },
        {
          "name": "Base",
          "slug": "base",
          "color": "#FFFFFF"
        },
        {
